{
  "name": "temporal-learning",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "format": "dprint fmt",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "postbuild": "node ./bin/check-font-preload-hash.js",
    "build_all": "npm-run-all --serial getsnips build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "getsnips": "snipsync",
    "clearsnips": "snipsync --clear",
    "check_links": "lychee docs --exclude-loopback --exclude-mail",
    "check_links_in_build": "lychee build --exclude-loopback --exclude-mail --exclude 'temporal-learning|algolia\\.net'",
    "scan": "npm-run-all -c --serial build check_links_in_build clearsnips",
    "get_courses": "node get_course_pages_from_lms.js",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "vale": "vale docs/**/*.md*"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/faster": "^3.10.1",
    "@docusaurus/plugin-content-docs": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@mdx-js/react": "^3.0.0",
    "algoliasearch": "^5.49.2",
    "chart.js": "3.7.1",
    "clsx": "^1.1.1",
    "prism-react-renderer": "^2.4.1",
    "pushfeedback": "^0.1.82",
    "pushfeedback-react": "^0.1.76",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-instantsearch": "^7.28.0",
    "react-player": "^2.10.1",
    "readdirp": "^3.6.0",
    "snipsync": "^1.9.0",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "caniuse-lite": "1.0.30001731",
    "qs": "6.14.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "dprint": "^0.45.0",
    "eslint": "^7.32.0",
    "eslint-plugin-react": "^7.23.2",
    "husky": "^6.0.0",
    "lint-staged": "^11.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
